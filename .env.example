# Live mode: calls Nemotron on Nebius Token Factory
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1   # check your Token Factory dashboard

# Exact model ids from your Token Factory catalogue
FT_MODEL_NANO=nvidia/nemotron-3-nano
FT_MODEL_SUPER=nvidia/nemotron-3-super
FT_MODEL_ULTRA=nvidia/nemotron-3-ultra

# FT_MODE=replay            # force offline replay (no key needed)
# FT_RUNNER=job             # run each candidate's tests via FT_JOB_SUBMIT_CMD
# FT_JOB_SUBMIT_CMD=...     # command that submits one Serverless Job; see README
# FT_ALLOW_CUSTOM=1         # allow "bring your own repo" (runs that repo's tests on this server!)
# FT_GITHUB_TOKEN=          # enables "Open pull request" for custom repos
# FT_PRICE_NANO=0.06,0.24   # $/1M tokens in,out (illustrative defaults; set your real prices)
